# 机密：绝不入库
/.secrets/
/wallet/
*.env
!*.env.example
/etc-dash/
master.key

# 构建产物
/bin/
/dist/
*.exe

# 依赖
# ★ 不加前导斜杠：/node_modules/ 只匹配仓库根目录，
#   会漏掉 web/node_modules/（曾导致 4706 个文件被误提交）
node_modules/
/web/dist/
# 注意：internal/api/dist 是 go:embed 的前端产物，必须入库，不要加 dist/ 通配规则
__pycache__/
*.pyc
/providers/*/venv/

# 本地
.DS_Store
*.log
